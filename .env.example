# Токен от @BotFather
TELOXIDE_TOKEN=123456789:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Ключи Telegram API: my.telegram.org → API development tools
API_ID=
API_HASH=

# Telegram ID пользователей, которым разрешено присылать файлы (через запятую).
# Свой ID можно узнать, написав боту что-нибудь — он ответит.
ALLOWED_USERS=

# Папка для сохранения файлов
SAVE_DIR=files

# Распознавание речи
WHISPER_GPU=true
WHISPER_UNLOAD_MIN=10
TRANSCRIBE_VIDEO=true
VIDEO_MAX_MIN=60
